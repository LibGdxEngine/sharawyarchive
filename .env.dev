# Django Development Environment Variables
DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=django-insecure-dev-secret-key-template-project-1234
ALLOWED_HOSTS=*

# PostgreSQL Development Configuration
# NOTE: DB_HOST=db targets the Docker Compose service name.
# For bare-venv runs outside Docker use DB_HOST=localhost.
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Meilisearch (docker-compose: http://meilisearch:7700)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devmasterkey

# Object storage — MinIO in dev (docker-compose overrides endpoint for containers)
AUDIO_S3_ENDPOINT_URL=http://localhost:9000
AUDIO_S3_BUCKET=shaarawy
AUDIO_S3_ACCESS_KEY_ID=minioadmin
AUDIO_S3_SECRET_ACCESS_KEY=minioadmin
AUDIO_S3_REGION=auto

# Cloudflare R2 (real bucket) — uncomment this block to point a bare-venv run
# (e.g. pipeline ingest) at production R2 instead of local MinIO. All four
# lines must be swapped together; the containers in docker-compose.yml keep
# using MinIO regardless. Real values live in .env.local (gitignored) — never
# commit them here.
#AUDIO_S3_ENDPOINT_URL=https://6452da3166483560913682a6dd5a5b77.r2.cloudflarestorage.com
#AUDIO_S3_BUCKET=shaarawy
#AUDIO_S3_ACCESS_KEY_ID=your-r2-access-key-id
#AUDIO_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Cloudflare API token for the R2 bucket (dashboard/API management only —
# not used by the S3 client).
R2_API_TOKEN=your-cloudflare-r2-api-token

# Sitemap canonical base URL (no trailing slash)
# docker-compose sets this to http://localhost or the actual domain
SITE_BASE_URL=http://localhost:3000

# Next.js API endpoint (dev proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# Engines: dev uses the deterministic stub recognizer, which FABRICATES text.
# The opt-in below is what lets `python -m pipeline.run` work locally; real
# ingest uses ASR_BACKEND=cohere (CO_API_KEY) or faster-whisper.
ALLOW_STUB_ENGINES=true
