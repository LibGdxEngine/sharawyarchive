# Django Production Environment Variables
DJANGO_SETTINGS_MODULE=core.settings.prod
SECRET_KEY=generate-a-secure-random-secret-key-for-production-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL Production Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=shaarawy
DB_USER=shaarawy
DB_PASSWORD=secure-database-password-change-me

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Meilisearch
MEILI_MASTER_KEY=generate-a-long-random-meili-master-key

# Cloudflare R2 audio storage (S3-compatible). Real values live in .env.local
# (gitignored) — never commit them here.
AUDIO_S3_ENDPOINT_URL=https://6452da3166483560913682a6dd5a5b77.r2.cloudflarestorage.com
AUDIO_S3_BUCKET=shaarawy
AUDIO_S3_ACCESS_KEY_ID=your-r2-access-key-id
AUDIO_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Same key pair under the names `manage.py sync_storage_to_r2` reads.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Cloudflare API token for the R2 bucket (dashboard/API management only —
# the S3 client above authenticates with the key id/secret, not this token).
R2_API_TOKEN=your-cloudflare-r2-api-token

# Inference engines. The Django defaults are "stub", which FABRICATES speech and
# ASR — production ingest must run a real engine or the archive fills
# with invented text (CLAUDE.md rule 1).
# 'cohere' transcribes through Cohere's hosted API (needs CO_API_KEY below);
# 'faster-whisper' is the local-GPU alternative. Word timings always come from
# the local CTC aligner either way.
ASR_BACKEND=cohere

# Cohere transcription API (https://dashboard.cohere.com). The default model is
# the Arabic-specialized latest release; uploads are capped at 25MB and longer
# audio is split at silences automatically.
CO_API_KEY=your-cohere-api-key
COHERE_ASR_MODEL=cohere-transcribe-arabic-07-2026

# Escape hatch that lets the stub engines run. Leave EMPTY in production.
# Set to true only for staging smoke tests — stub engines fabricate speech.
ALLOW_STUB_ENGINES=

# Error tracking (optional; blank disables)
# SENTRY_DSN is server-side (Django, Celery, Next.js server + build-time source
# maps). NEXT_PUBLIC_SENTRY_DSN is shipped to the browser bundle; leave it blank
# unless you want client-side error reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Next.js Production API Endpoint (pointing to your production domain)
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Public origin the frontend builds canonical URLs and Open Graph tags against.
# No trailing slash. Mirror of DOMAIN_NAME.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Canonical origin Django writes into sitemap.xml. No trailing slash.
# Mirror of DOMAIN_NAME; leave blank to inherit DOMAIN_NAME from compose.
SITE_BASE_URL=https://yourdomain.com

# Caddy Domain — scheme-prefixed; also the fallback for SITE_BASE_URL and
# NEXT_PUBLIC_SITE_URL.
DOMAIN_NAME=https://yourdomain.com

# CORS / CSRF configuration (must match your domain name)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# SSL redirect (set to False if SSL is handled elsewhere, e.g. Cloudflare)
SECURE_SSL_REDIRECT=True
