{$DOMAIN_NAME:http://localhost} {
    encode gzip zstd

    # Health endpoints (uptime checks hit these directly)
    reverse_proxy /healthz backend:8000
    reverse_proxy /readyz backend:8000

    # Backend
    reverse_proxy /api/* backend:8000
    reverse_proxy /admin/* backend:8000
    reverse_proxy /static/* backend:8000

    # Everything else: Next.js standalone server
    reverse_proxy /* frontend:3000

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
